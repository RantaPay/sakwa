# Copy to apps/landing/.env.local and apps/platform/.env.local as needed.
# Never commit real values.

# Public URLs
NEXT_PUBLIC_SITE_URL=https://sakwaagro.com
NEXT_PUBLIC_PLATFORM_URL=https://app.sakwaagro.com
NEXT_PUBLIC_ENQUIRY_ENDPOINT=https://app.sakwaagro.com/api/enquiries

# Public contact (shown on the landing page). Replace placeholders before launch.
NEXT_PUBLIC_PHONE=[Phone number]
NEXT_PUBLIC_WHATSAPP_E164=[WhatsApp number in international format, digits only]
NEXT_PUBLIC_EMAIL=[Contact email]
NEXT_PUBLIC_ADDRESS=[Office address]
NEXT_PUBLIC_OPERATING_LOCATIONS=[Operating locations]

# Trust strip. Leave the bracketed text until the owner supplies real figures.
NEXT_PUBLIC_YEARS_OPERATING=[Years operating]
NEXT_PUBLIC_BAGS_SUPPLIED=[Number of bags supplied]
NEXT_PUBLIC_CUSTOMERS_SERVED=[Number of customers served]
NEXT_PUBLIC_WAREHOUSE_COUNT=[Number of warehouses]

# Local demo logins (see demo.md). Set to false when using a real project.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase. Local defaults from `supabase start`. Replace for a hosted project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
