# Template only. Copy to .env.local and fill in. Never put real keys here:
# this file is committed and the repo is public.

# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase → Settings → Database → Connection string (pooler, port 5432)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require

# URLs
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# Email for investor enquiry alerts (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sakwa Agro Enterprise <records@sakwaagro.com>
DIRECTOR_ALERT_EMAIL=
